{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-mendan-kun",
  "main": "worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "vars": {
    "OWNER_ID": "default",
    "OWNER_DISPLAY_NAME": "",
    // 回答: gemini / openai / anthropic。Claudeへの切替手順はdocs/setup/README.md。
    "ANSWER_PROVIDER": "gemini",
    "ANSWER_MODEL": "gemini-3.8-flash",
    // Embedding: gemini / openai。回答がanthropicでも現在の検索設定を維持する。
    "EMBEDDING_PROVIDER": "gemini",
    "EMBEDDING_MODEL": "gemini-embedding-2",
    "EMBEDDING_DIMENSIONS": "1536",
    "DAILY_REQUEST_LIMIT": "100",
    "IP_HOURLY_LIMIT": "30",
    // 音声は初期状態で無効。Gemini Secretと利用料の確認後に有効化する。
    "VOICE_ENABLED": "false",
    "VOICE_STT_MODEL": "gemini-3.5-transcribe",
    "VOICE_TTS_MODEL": "gemini-3.1-flash-tts-preview",
    "VOICE_TTS_MODE": "buffered",
    "VOICE_NAME": "Kore",
    // STT・音声回答を合算した回数。通常の1往復は2回分。
    "VOICE_DAILY_REQUEST_LIMIT": "40",
    "VOICE_IP_HOURLY_LIMIT": "10"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-mendan-kun",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ai-mendan-kun" }]
}
