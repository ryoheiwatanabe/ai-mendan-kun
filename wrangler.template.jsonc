{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-mendan-kun",
  "main": "worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "vars": {
    "OWNER_ID": "default",
    "OWNER_DISPLAY_NAME": "",
    // 回答: gemini / openai / anthropic / opencode。切替手順はdocs/setup/README.md。
    "ANSWER_PROVIDER": "gemini",
    "ANSWER_MODEL": "gemini-3.8-flash",
    // jev_v1は現在のOpenCode/OpenAI互換の生成に対応。TYPESAFE_API_KEYはWorkers Secretへ。
    // 公開切替は試用後に行う。legacyは手動ロールバック用。
    "ANSWER_PIPELINE": "legacy",
    "JEV_TIMEOUT_MS": "4000",
    "ANSWER_TIMEOUT_MS": "25000",
    // OpenCode Go選択時のJSON出力。schema（既定）はjson_schema strict、objectはjson_object。
    // DeepSeek系はGo側がjson_schemaを400で拒否するため、そのモデルだけobjectにする。
    "OPENCODE_JSON_MODE": "schema",
    // 診断用。1で回答の最終イベントに固定コードと件数だけを付け足す（本文は含めない）。既定は無効。
    "DEBUG_TRACE": "0",
    // Embedding: gemini / openai / workersai。回答がanthropic/opencodeでも現在の検索設定を維持する。
    "EMBEDDING_PROVIDER": "gemini",
    "EMBEDDING_MODEL": "gemini-embedding-2",
    "EMBEDDING_DIMENSIONS": "1536",
    "DAILY_REQUEST_LIMIT": "100",
    "IP_HOURLY_LIMIT": "30",
    // 音声は初期状態で無効。Gemini Secretと利用料の確認後に有効化する。
    "VOICE_ENABLED": "false",
    "VOICE_STT_MODEL": "gemini-3.5-transcribe",
    "VOICE_TTS_MODEL": "gemini-3.1-flash-tts-preview",
    "VOICE_TTS_MODE": "buffered",
    "VOICE_NAME": "Kore",
    // STT・音声回答を合算した回数。通常の1往復は2回分。
    // 認識と回答の各工程に適用。1往復で同じ枠を二重に消費しない。
    "VOICE_DAILY_REQUEST_LIMIT": "40",
    "VOICE_IP_HOURLY_LIMIT": "10"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-mendan-kun",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ai-mendan-kun" }],
  // Workers AIの埋め込みを使うときだけ必要（EMBEDDING_PROVIDER=workersai）。
  "ai": { "binding": "AI" }
}
