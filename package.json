{
  "name": "ai-mendan-kun",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "vad:prepare": "node scripts/prepare-vad-assets.mjs",
    "predev": "npm run vad:prepare",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run vad:prepare",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "node scripts/preview.mjs",
    "preview:record": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/conversation-recorder.ts",
    "admin:dev": "node scripts/admin-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "knowledge:prepare": "node --experimental-strip-types scripts/prepare-import.ts",
    "knowledge:import": "node --experimental-strip-types scripts/import.ts",
    "knowledge:revoke": "node --experimental-strip-types scripts/revoke.ts",
    "golden": "node --experimental-strip-types scripts/golden.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@ricky0123/vad-web": "0.0.30",
    "next": "16.3.4",
    "onnxruntime-web": "1.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
